# Copy to `.env` and fill in. This tunnel only needs to carry the tracker/feed
# HTTP traffic, so its credentials are unrelated to ../media/.env's — different
# provider, different exit, is fine and expected.

VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADDRESSES=10.14.14.2/32

LAN_SUBNETS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# --- this tunnel's control server -------------------------------------------
# sharerr polls its own gluetun on localhost to follow the tracker/feed address.
# Every control-server route needs a credential. Generate one:
#
#   docker run --rm qmcgaw/gluetun:v3.41.3 genkey
#
# Then put THIS value in the vault under `gluetun.api_key` — no suffix, because
# this tunnel is the tracker's:
#
#   printf %s "$GLUETUN_API_KEY" | \
#     docker compose exec -T sharerr sharerr vault set gluetun.api_key
#
# It is a different key from ../media/.env's GLUETUN_API_KEY, which goes in as
# `gluetun_client.api_key`. Two tunnels, two control servers, two keys.
GLUETUN_API_KEY=

# Generate once and keep it — losing it loses every stored credential:
#   openssl rand -base64 32
SHARERR_MASTER_KEY=

# The same host path as ../media/.env's MEDIA_PATH. sharerr needs to see the
# identical files qBittorrent is seeding, just at its own mount point.
MEDIA_PATH=/srv/media

TZ=Etc/UTC
RUST_LOG=sharerr=info,warn
