# Copy to `.env` and fill in. This tunnel only needs to move qBittorrent's
# traffic, so its credentials are unrelated to ../sharerr/.env's.

VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADDRESSES=10.13.13.2/32

LAN_SUBNETS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# --- this tunnel's control server -------------------------------------------
# sharerr polls this gluetun over `sharerr-shared` to follow the torrent
# client's exit address and forwarded port. Every control-server route needs a
# credential. Generate one:
#
#   docker run --rm qmcgaw/gluetun:v3.41.3 genkey
#
# Then put THIS value in sharerr's vault under `gluetun_client.api_key` — note
# the `_client`, because this tunnel is the client's, not the tracker's. Run it
# from ../sharerr/, where the sharerr container lives:
#
#   printf %s "<this value>" | \
#     docker compose exec -T sharerr sharerr vault set gluetun_client.api_key
#
# It is a different key from ../sharerr/.env's GLUETUN_API_KEY. Two tunnels, two
# control servers, two keys.
GLUETUN_API_KEY=

# The library on the host, containing `tv/` and `movies/` subdirectories.
# Mounted read-only into qBittorrent (at /downloads), Sonarr (at /tv) and
# Radarr (at /movies).
MEDIA_PATH=/srv/media

PUID=1000
PGID=1000
TZ=Etc/UTC
