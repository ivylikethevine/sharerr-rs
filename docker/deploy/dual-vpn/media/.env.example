# Copy to `.env` and fill in. This tunnel only needs to move qBittorrent's
# traffic, so its credentials are unrelated to ../sharerr/.env's.

VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADDRESSES=10.13.13.2/32

LAN_SUBNETS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# The library on the host, containing `tv/` and `movies/` subdirectories.
# Mounted read-only into qBittorrent (at /downloads), Sonarr (at /tv) and
# Radarr (at /movies).
MEDIA_PATH=/srv/media

PUID=1000
PGID=1000
TZ=Etc/UTC
