# Copy to `.env` and fill in. `docker compose up -d` reads it automatically.

# --- your existing stack ----------------------------------------------------
# The docker network your qBittorrent and *arr containers are already on.
# Compose names a project's default network `<project>_default`. Find it with:
#
#   docker inspect -f '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' qbittorrent
#
# It is joined, not created — this stack coming down will not touch it.
EXTERNAL_NETWORK=media_default

# --- sharerr ----------------------------------------------------------------
# Generate once and keep it — losing it loses every stored credential:
#   openssl rand -base64 32
SHARERR_MASTER_KEY=

# The library on the host, mounted read-only at /media. Must be the same bytes
# your torrent client seeds; the path mappings in config/sharerr.toml translate
# between sharerr's view and everyone else's.
MEDIA_PATH=/srv/media

TZ=Etc/UTC
RUST_LOG=sharerr=info,warn
