# Generated by terraform/fly — edit the .tf and re-apply, not this file.
app            = "${app_name}"
primary_region = "${region}"

[build]
  image = "${image}"

[env]
  TZ = "${tz}"
  RUST_LOG = "${rust_log}"
  LIGHTHOUSE_BIND = "0.0.0.0:7878"
  LIGHTHOUSE_SECRET_FILE = "/data/lighthouse.secret"

[[mounts]]
  source      = "lighthouse_data"
  destination = "/data"

[http_service]
  internal_port       = 7878
  force_https         = true
  # A rendezvous that is asleep when a friend looks up a quiet peer has
  # failed at its one job: never scale to zero.
  auto_stop_machines  = "off"
  auto_start_machines = true
  min_machines_running = 1

  [http_service.concurrency]
    type       = "requests"
    soft_limit = 200
    hard_limit = 250

[[vm]]
  size   = "${vm_size}"
  memory = "${memory}"
