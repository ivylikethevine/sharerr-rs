# Copy to `.env` and fill in. `docker compose up -d` reads it automatically.

# --- sharerr ----------------------------------------------------------------
# Generate once and keep it — losing it loses every stored credential:
#   openssl rand -base64 32
SHARERR_MASTER_KEY=

# --- tailscale --------------------------------------------------------------
# An auth key from the Tailscale admin console (Settings -> Keys), or from
# `headscale preauthkeys create` on a Headscale server. Used on first start
# only; the node's state persists in the tailscale-state volume after that.
TS_AUTHKEY=
# The machine name on the tailnet.
TS_HOSTNAME=sharerr
# Your Headscale server, e.g. https://HOST. Leave empty for Tailscale's own.
TS_LOGIN_SERVER=

# --- the rest ---------------------------------------------------------------
# The library on the host. Sonarr and Radarr get their own subdirectories
# read-write; qBittorrent and sharerr get the whole tree read-only, at
# /downloads and /media respectively. The path mappings in config/sharerr.toml
# translate between those three views.
MEDIA_PATH=/srv/media

PUID=1000
PGID=1000
TZ=Etc/UTC
RUST_LOG=sharerr=info,warn
