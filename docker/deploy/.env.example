# Copy to `.env` and fill in. `docker compose up -d` reads it automatically.

# --- the tunnel -------------------------------------------------------------
# As written this expects a WireGuard endpoint you control, which is the only
# shape where all three inbound ports actually forward. For a commercial
# provider, set VPN_SERVICE_PROVIDER to its name (e.g. `mullvad`, `protonvpn`)
# and leave the WIREGUARD_ENDPOINT_* pair blank — gluetun supplies the servers.
VPN_SERVICE_PROVIDER=custom
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_ADDRESSES=10.13.13.2/32

# Subnets gluetun may reach outside the tunnel: your LAN, and docker's own
# ranges so the published WebUI ports can answer. Must not overlap
# WIREGUARD_ADDRESSES.
LAN_SUBNETS=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8

# --- sharerr ----------------------------------------------------------------
# Generate once and keep it — losing it loses every stored credential:
#   openssl rand -base64 32
SHARERR_MASTER_KEY=

# --- the rest ---------------------------------------------------------------
# The library on the host. Mounted read-only into both containers, at /downloads
# for qBittorrent and /media for sharerr.
MEDIA_PATH=/srv/media

PUID=1000
PGID=1000
TZ=Etc/UTC
RUST_LOG=sharerr=info,warn
