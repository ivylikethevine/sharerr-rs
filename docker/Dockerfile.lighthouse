# sharerr-lighthouse — the standalone rendezvous service, its own image, its
# own port. See docs/ROADMAP.md's "The lighthouse" for what it is and why it
# is deliberately not built into the main sharerr image: it is meant to be
# self-hosted by anyone, on neutral ground away from any particular library.
#
# Mirrors the main Dockerfile's build shape (see it for the reasoning behind
# each choice — cross-compilation, cache mounts, the runtime split) but builds
# only crates/sharerr-lighthouse, which does not depend on the rest of the
# workspace: no *arr clients, no torrent clients, no sqlx. That keeps this
# image's build fast and its runtime layer minimal — there is nothing here
# worth stealing, so there is nothing here worth carrying more than it needs.

# Pinned to the workspace's declared rust-version — see the main Dockerfile's
# comment on why both pins have to move together.
FROM --platform=$BUILDPLATFORM rust:1.98-bookworm@sha256:82150a52ec202c1b14d7817e14516c392bb7f5cfebd88f1ed531cb37ebd39922 AS builder

# Supplied by BuildKit. Names the architecture of the *runtime* image, not of
# this stage.
ARG TARGETARCH

WORKDIR /src

# No cmake, no C compiler: unlike the main image, this crate pulls in neither
# aws-lc-rs (its ed25519-dalek dependency, `curve25519-dalek`, is pure Rust)
# nor sqlx, so there is nothing here to compile from source — only the cross
# linker needs installing, and only for arm64.
RUN set -eu; \
    case "$TARGETARCH" in \
        amd64) TRIPLE=x86_64-unknown-linux-gnu; CROSS= ;; \
        arm64) TRIPLE=aarch64-unknown-linux-gnu; \
               CROSS="gcc-aarch64-linux-gnu g++-aarch64-linux-gnu libc6-dev-arm64-cross" ;; \
        *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    echo "$TRIPLE" > /triple; \
    if [ -n "$CROSS" ]; then \
        apt-get update; \
        apt-get install --yes --no-install-recommends $CROSS; \
        rm --recursive --force /var/lib/apt/lists/*; \
    fi; \
    rustup target add "$TRIPLE"

ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc \
    CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++ \
    AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar

# The whole workspace, same reasoning as the main Dockerfile: splitting
# manifests from sources to warm a dependency cache duplicates the crate
# layout here and rots when a crate is added. `--package sharerr-lighthouse`
# below still only builds this crate and its own dependency subtree.
COPY . .

RUN --mount=type=cache,target=/usr/local/cargo/registry,id=lighthouse-registry-$TARGETARCH \
    --mount=type=cache,target=/src/target,id=lighthouse-target-$TARGETARCH \
    TRIPLE="$(cat /triple)" \
 && cargo build --release --locked --package sharerr-lighthouse --target "$TRIPLE" \
 && install -D "target/$TRIPLE/release/sharerr-lighthouse" /out/sharerr-lighthouse

# No --platform override, deliberately — see the main Dockerfile.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS runtime

RUN apt-get update \
 && apt-get install --yes --no-install-recommends ca-certificates curl \
 && rm --recursive --force /var/lib/apt/lists/*

# Runs unprivileged. /data holds only the decoy secret — see
# `sharerr_lighthouse::main`'s `load_or_create_secret` — which is worth
# protecting from a casual read on the host but is not the credential vault
# the main image carries; losing it just reshuffles decoys after a restart.
RUN groupadd --gid 1000 lighthouse \
 && useradd --uid 1000 --gid 1000 --create-home --home-dir /home/lighthouse lighthouse \
 && mkdir --parents /data \
 && chown lighthouse:lighthouse /data

COPY --from=builder /out/sharerr-lighthouse /usr/local/bin/sharerr-lighthouse

USER lighthouse
WORKDIR /home/lighthouse

VOLUME ["/data"]
EXPOSE 7878

ENV LIGHTHOUSE_BIND=0.0.0.0:7878 \
    LIGHTHOUSE_SECRET_FILE=/data/lighthouse.secret

# `/lighthouse/v1/health` rather than a bare `/health`: see
# `sharerr_lighthouse::routes`'s comment on why every route here lives under
# the versioned prefix.
HEALTHCHECK --interval=60s --timeout=10s --start-period=15s --retries=3 \
    CMD curl --fail --silent --show-error http://localhost:7878/lighthouse/v1/health || exit 1

ENTRYPOINT ["/usr/local/bin/sharerr-lighthouse"]
