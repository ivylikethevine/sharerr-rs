/target
**/*.rs.bk

# Local runtime state — vault, sqlite db, generated torrents.
/data
/config/sharerr.toml

# Test fixtures are generated, never committed (they are large synthetic blobs).
/tests/fixtures/media

# Sonarr's and Radarr's own config and databases in the compose test stack. Bind
# mounted rather than named volumes so `seed-arr` can write to them from the host.
/docker/state
/docker/state-vpn
/docker/state-tm
/docker/state-rt
/docker/state-two-instance
# The mesh stack's own live config copies — see run_docker_tests_mesh.sh for
# why these are scratch copies of docker/config-mesh-*/sharerr.toml rather
# than that checked-in directory itself: one scenario rewrites a node's
# config in place through a real settings POST, the same way an operator's
# browser would, and that must never land on the tracked template.
/docker/state-mesh

# Never commit a master key.
.env
*.key

# Local agent scratch: memory, plans, session settings. Note this does *not* cover
# the tracked CLAUDE.md at the repository root, which is shared on purpose.
.claude

# Terraform working state for the hosted-lighthouse modules under
# docker/deploy/lighthouse/terraform. State can hold addresses and key names;
# keep it with the rest of your homelab's, not here.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
.terraform.lock.hcl
docker/deploy/lighthouse/terraform/fly/.generated/
